# Copy to .env (git-ignored) and fill in. Config defaults live in config.yaml.

# Save every received turn as a WAV in debug.audio_dir (off by default; privacy NFR).
DEBUG_SAVE_AUDIO=0

# Optional overrides of the llm section in config.yaml.
# LLM_MODEL=gemini/<model-name>
# LLM_API_BASE=http://localhost:8000/v1

# LiteLLM reads provider keys straight from the environment.
# Get one at https://aistudio.google.com/apikey (needed for the default gemini/ model).
GEMINI_API_KEY=
